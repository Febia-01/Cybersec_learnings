echo
whoami
id [-un]
pwd
~ - home directory
ls [~ - all content in the home directory] [-l - detailed listing] [-a - hidden files] [-d - list that directory as well]
cd
touch
mkdir [-p - to create missing parent directory and avoids error if it's already existing]
cp [-r recursive]
mv - rename and move
rm [-i - interactive flag, prompts before deletion]
rmdir [-f - forcefully delete (-rf)]
cat [-n - number the output lines]
head [-n1 - displays only first line, -c1 - first character or byte]
tail
diff [-r - entire directory]
chown [owner:group]
chmod [owner, group, other & read(4), write(2), execute(1) & + - for adding, - - for removing] [(special permission)setgid g+s / 2]
sudo
useradd [-m - to create home directory as well, -U - primary group of same name, -s /bin/bash - for setting bash as shell]
grep [find from directory or file [-w - match whole word, -i - case insensitive, -E - search for multiple patterns ('pattern1|pattern2')]
passwd - to set password [-l lock, -u unlock]
usermod - modify user properties [-d directory, -s shell, -aG append to group]
su -switch user
userdel [-r remove the home directory as well]
uname - displays the kernel name [-a - comprehensive system informations]
uptime - check how long the system has been running and the load on it
top - provides a dynamic, real-time view of running systems [q - for exiting from it]
tar (tape archive) - for archiving [tar -czf archive.tar.gz file1 file2] (*2023* - includes all files containing 2023 in the fillename)
	c - create new archive 
	z - compress in gzip format (.gz is the extension for gzip compressed files)
	f - specify filename of the archive
dmesg - to view kernel messages
| (pipe operator) - send the output of one command to the input of another one
date - displays date [date +%F - ISO format (YYYY-MM-DD)]
cal - displays calendar current month
expr - integer arithmetic (multiplication \*)
figlet - large letter format (ASCII art)
touch app{1..3}.log worker{1..2}.log notes.txt - create files named app1.log app2.log app3.log worker1.log worker2.log notes.txt
printf '%s\n' *.log - displays every files named with .log line wise
umask - to control the permission bits removed when the shell creates new files and directories

standard directories
/etc - system wide configuration
/home - ordinary users home directories
/tmp - stores temporary data
/usr - contains many installed programs and shared resources
/var - contains changing data such as logs and caches

stat -  displays metadata such as size, permissions, owner, timestamps, and inode number [An inode is the filesystem record that stores a file's metadata and points to its data. 
A filename is a directory entry that refers to an inode. The -i option of ls also shows inode numbers]
ln - creates hard link (without option) [-s option creates a symbolic link, sometimes called a symlink. A symbolic link stores a path to another file.]
